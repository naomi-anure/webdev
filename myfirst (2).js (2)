// relational operators: true or false (booleans)
console.log(20 == "20") // equal = true
console.log(20 != 21) // not equal = true
console.log(20 === "20") // strict equal: value and type = false
console.log(20 !== "20") // not strict equal: value and type = true
console.log(20 < 20) // less than = false
console.log(20 > 20) // greater than = false
console.log(20 <= 20) // less than or equal to= true
console.log(20 >= 20) // greater than or equal to = true


// logical operators
// &&, both experssions must yield true
console.log(30 > 20 && 20 > 10) // true && true = true
console.log(30 > 20 && 20 > 100) // true && false = false

// ||, either expression can yield true
console.log(30 > 20 || 20 > 10) // true
console.log(30 > 20 || 20 > 100)  // true

// !, not operator
console.log(!(30 > 20 || 20 > 10)) // true
console.log(!(30 > 20 || 20 > 100)) // false

